{
  "manifest_version": 3,
  "name": "Kinojo",
  "version": "1.3.1.48",
  "description": "Kinojo - Server Worker launcher and progress viewer.",
  "permissions": [
    "storage",
    "windows",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://aion2.plaync.com/*",
    "https://kinojo.info/*",
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://aion2.plaync.com/ko-kr/characters/*"
      ],
      "css": [
        "ui/styles.css"
      ],
      "js": [
        "ui/icons.js",
        "core/config.js",
        "core/supabase.js",
        "core/auth.js",
        "ui/theme.js",
        "ui/ui.js",
        "updater/updater-phases.js",
        "updater/updater-state.js",
        "updater/updater-timers.js",
        "updater/updater.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "version_name": "1.3.1.48 Decimal Progress and Stored Detail Guard"
}
